model Department {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now())
  updated_at    DateTime       @updatedAt
  announcements Announcement[]
  employees     Employee[]     @relation("DepartmentEmployees")

  @@map("departments")
}
